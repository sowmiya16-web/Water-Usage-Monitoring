# Copy to .env for local overrides (not needed for normal local dev — the app
# defaults to a relative "/api", proxied to localhost:8080 by vite.config.js).
#
# Set this in Vercel's Project Settings → Environment Variables for the deployed
# build: the full base URL of your deployed backend, ending in /api.
# Example: https://water-monitoring-backend.onrender.com/api
VITE_API_URL=
